                "federation-token",
                ":InstanceId"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "InstanceId",
                  "description": "(Required) The identifier of the Amazon Connect instance."
