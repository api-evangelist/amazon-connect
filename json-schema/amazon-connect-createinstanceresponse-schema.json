{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/CreateInstanceResponse",
  "title": "CreateInstanceResponse",
  "type": "object",
  "properties": {
    "Id": {
      "type": "string",
      "description": "The identifier for the instance.",
      "example": "a1b2c3d4-5678-90ab-cdef-11111EXAMPLE"
    },
    "Arn": {
      "type": "string",
      "description": "The Amazon Resource Name (ARN) of the instance.",
      "example": "arn:aws:connect:us-east-1:123456789012:instance/a1b2c3d4-5678-90ab-cdef-11111EXAMPLE"
    }
  }
}